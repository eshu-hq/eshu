{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/goal-role-router.py\" codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.codex/hooks/eshu-doc-staleness.sh",
            "statusMessage": "Checking Go doc freshness"
          }
        ]
      }
    ]
  }
}
