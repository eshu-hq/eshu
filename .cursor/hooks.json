{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 scripts/cursor-hook.py beforeShellExecution .claude/hooks/guard-live-gate.sh",
        "timeout": 60,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "matcher": "Write",
        "command": "python3 scripts/cursor-hook.py preToolUse .claude/hooks/skill-nudge.sh",
        "timeout": 60,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "matcher": "Read",
        "command": "python3 scripts/cursor-hook.py postToolUse .claude/hooks/skill-loaded.sh",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": "python3 scripts/cursor-hook.py subagentStart",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 scripts/cursor-hook.py afterFileEdit .claude/hooks/eshu-doc-staleness.sh",
        "timeout": 30
      }
    ],
    "preCompact": [
      {
        "command": "python3 scripts/cursor-hook.py preCompact .claude/hooks/on-compact.sh",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 scripts/cursor-hook.py beforeSubmitPrompt .claude/hooks/goal-refresh.sh",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 scripts/cursor-hook.py stop .claude/hooks/goal-continue.sh",
        "timeout": 10
      }
    ]
  }
}
