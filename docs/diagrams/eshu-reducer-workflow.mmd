flowchart TB
    subgraph MAINT["Maintenance pass (ingester, per shard drain)"]
        Drain["shard drain"] --> Maint["RunDeferredRelationshipMaintenanceAfterShardDrain"]
        Maint --> Backfill["BackfillAllRelationshipEvidence<br/>commit deferred evidence first"]
        Backfill --> SkipSet["same-pass skip-set<br/>partitions this pass skipped"]
        SkipSet --> ReopenTx["reopenMaintenanceWorkItemsInTransaction<br/>ONE transaction, all-or-nothing"]
        ReopenTx --> DM["deployment_mapping reopen"]
        ReopenTx --> CI["code_import_repo_edge reopen"]
        ReopenTx --> Corr["correlation chain reopen<br/>no skip-set: waits on generation activation"]
        DM --> Gate["applyReopenPartitionMemoGate"]
        CI --> Gate
        Gate -->|in skip-set| Stay["stays succeeded"]
        Gate -->|not skipped| Breaker{"evaluateReopenCircuitBreaker"}
        Breaker -->|pool < 20| ReopenAll["reopen all"]
        Breaker -->|reopen share > 50%| Park["PARK: stay succeeded, re-listed next pass<br/>log + parked_by_breaker counter"]
        Breaker -->|otherwise| Reopen["ReducerQueue.ReopenSucceeded<br/>succeeded -> pending"]
    end

    subgraph DRAINLOOP["Drain loop (reducer, ESHU_REDUCER_WORKERS)"]
        ReopenAll --> Pending["fact_work_items<br/>pending / retrying"]
        Reopen --> Pending
        Pending --> Claim["Claim oldest-first, SKIP LOCKED"]
        Claim --> Beat["startHeartbeat<br/>lease until Ack/Fail"]
        Beat --> Exec["Execute:<br/>GenerationCheck -> Definition -> Handler.Handle"]
        Exec --> Writes["writes: Postgres facts + graph via EdgeWriter"]
        Exec --> Ack["Ack -> succeeded"]
        Exec --> Sup["Superseded: newer generation, no write"]
        Exec --> Fail{"Fail: attempt budget left?"}
        Fail -->|yes| Retry["retrying (backoff)"]
        Fail -->|no| DL["dead_letter"]
        Retry --> Pending
    end

    subgraph STORM["Storm loop (pre-#11595; breaker cuts it at Park)"]
        Miss["fleet-wide miss:<br/>fingerprint flip + withheld memo"] -->|every pass| Reopen
        Reopen -->|pool grows faster than drain| Miss
        Park -->|cuts the loop| Pending
    end
