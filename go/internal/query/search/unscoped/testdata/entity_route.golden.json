  "statement_set": {
    "StepFirst": "\n(SELECT 'hit' AS kind, entity_id, repo_id, relative_path, entity_type, entity_name, start_line, end_line, coalesce(language, ''), coalesce(source_cache, ''), metadata\n FROM (SELECT entity_id, repo_id, relative_path, entity_type, entity_name, start_line, end_line, language, source_cache, metadata\n       FROM content_entities\n       ORDER BY repo_id, relative_path, start_line, entity_id\n       LIMIT $2::bigint) head\n WHERE source_cache ILIKE '%' || $1 || '%'\n ORDER BY repo_id, relative_path, start_line, entity_id\n LIMIT $3::bigint)\nUNION ALL\n(SELECT 'edge', entity_id, repo_id, relative_path, '', '', start_line, 0, '', '', NULL\n FROM content_entities\n ORDER BY repo_id, relative_path, start_line, entity_id\n OFFSET ($2::bigint - 1) LIMIT 1)",
