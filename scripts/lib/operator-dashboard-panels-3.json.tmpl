    {
      "id": 36,
      "type": "timeseries",
      "title": "Claim-Plane Request Duration p50 / p99 by Operation",
      "description": "Per-operation claim-plane round-trip latency percentiles over a 5-minute window. Client buckets run 0.005-10 s; the 10 s client timeout lands in the last finite bucket. Sustained p99 growth without saturation is a regression.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 113},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.50, sum by (le, operation) (rate(${CLAIM_PLANE_REQUEST_DURATION_BUCKET}[5m])))",
          "legendFormat": "p50 {{operation}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "histogram_quantile(0.99, sum by (le, operation) (rate(${CLAIM_PLANE_REQUEST_DURATION_BUCKET}[5m])))",
          "legendFormat": "p99 {{operation}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 5}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
